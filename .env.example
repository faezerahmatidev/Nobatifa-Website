# Supabase local configuration — TEMPLATE ONLY, never commit real values.
# Used by Supabase CLI (`supabase link`, `supabase db push`) and local tooling.
# Frontend values live in src/environments/ (publishable key only).

# Project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=

# Publishable (anon) key — safe for browser use.
SUPABASE_PUBLISHABLE_KEY=

# Service-role key — LOCAL MIGRATIONS/ADMIN USE ONLY.
# NEVER put this in src/, environments files, screenshots, logs, or Git.
SUPABASE_SERVICE_ROLE_KEY=
